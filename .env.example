# Copia este fichero como ".env" (junto a la app, o en %APPDATA%\AVAMETMonitor en el .exe) y rellénalo.
# El fichero .env NO se sube a git (está en .gitignore).

# Token del bot de Telegram (@BotFather). Formato 123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AVAMET_TELEGRAM_TOKEN=

# Contraseña que deben escribir tus compañeros para suscribirse (mínimo 8 caracteres)
AVAMET_TELEGRAM_CLAVE=

# Token de la API (/api/shutdown, /api/ubicacion). Opcional: si no lo pones se genera api_token.txt
# AVAMET_API_TOKEN=

# Chat ID de Telegram del ADMINISTRADOR: el único que puede cambiar la ubicación con /pueblo.
# Si está vacío, nadie puede (los demás reciben "No tienes permisos"). Para saber tu ID escribe /id al bot.
AVAMET_ADMIN_CHAT_ID=

# Minutos de SIN DATOS antes de avisar por Telegram, en segundos (por defecto 180; 0 = inmediato)
# AVAMET_TELEGRAM_DEMORA_SIN_DATOS_S=180

# Contacto (opcional, p. ej. un correo) que se añade al User-Agent de las consultas a aviationweather.gov
# AVAMET_CONTACTO=

# --- Servidor / Raspberry Pi (opcional) ---
# Carpeta de datos (historial.db, api_token.txt, boltwood.dat, ...). Por defecto: ./data/ en Linux
# AVAMET_DATA_DIR=/opt/avamet-monitor/data
# Dirección y puerto de escucha (run.py --headless usa 0.0.0.0 por defecto)
# AVAMET_HOST=0.0.0.0
# AVAMET_PORT=8000

# Vigilante (opcional): espera inicial y máxima, en segundos, entre reintentos si el bucle principal falla
# AVAMET_VIGILANTE_ESPERA_S=5
# AVAMET_VIGILANTE_ESPERA_MAX_S=300
# Cada cuántos segundos comprueba el guardián que el bucle sigue vivo
# AVAMET_GUARDIAN_PERIODO_S=30

# METAR (opcional): segundos que se muestra el último METAR bueno si aviationweather.gov falla (por defecto 10800 = 3 h)
# AVAMET_METAR_CACHE_MAX_S=10800
# ... y segundos máximos que ese dato de caché puede alimentar el radar predictivo (por defecto 1800 = 30 min)
# AVAMET_METAR_CACHE_CALCULO_S=1800
# Latido del flujo en tiempo real, en segundos (por defecto 15; debe ser mucho menor que 60)
# AVAMET_SSE_LATIDO_S=15

# Diagnóstico de red (opcional): segundos que se conservan los eventos en diagnostico.log (por defecto 3600 = 1 h)
# AVAMET_DIAG_VENTANA_S=3600
# Ruta del log de diagnóstico (por defecto, en la carpeta de datos)
# AVAMET_DIAG_LOG_PATH=


# Estación de respaldo (opcional): si la estación principal deja de enviar datos, se usa la cercana más próxima que sí los
# envíe, como mucho a esta distancia en km (por defecto 10; 0 = desactivado: la app pasa a SIN DATOS como antes) ...
# AVAMET_RESPALDO_MAX_KM=10
# ... y se vuelve a la principal cuando ha publicado este número de lecturas nuevas (por defecto 2)
# AVAMET_RESPALDO_LECTURAS_VUELTA=2

# Satélite (opcional): minutos a partir de los cuales la interfaz avisa de que la imagen mostrada es antigua (por defecto 45)
# AVAMET_METEOSAT_IMAGEN_VIEJA_MIN=45
# Satélite (opcional): radio en km alrededor de la estación en el que una nube por debajo de -20 °C cuenta como aviso en el informe
# (por defecto 40; antes se usaba todo el recorte de ~334 x 290 km y daba casi siempre falsa alarma)
# AVAMET_METEOSAT_RADIO_KM=40
# Satélite (opcional): franja de crepúsculo. Sol a esta altura o más = día (por defecto -3) ...
# AVAMET_METEOSAT_SOL_DIA=-3
# ... y a esta altura o menos = noche (por defecto -9). Entre ambas, «SIN DETERMINAR (crepúsculo)» si no hay nube fría clara.
# AVAMET_METEOSAT_SOL_NOCHE=-9

# Diagnóstico (opcional): días que se conservan los ficheros diarios diagnostico_AAAA-MM-DD.log (por defecto 30; 0 = desactivado) ...
# AVAMET_DIAG_HISTORICO_DIAS=30
# ... y carpeta donde se guardan (por defecto, diagnostico_historico dentro de la carpeta de datos)
# AVAMET_DIAG_HISTORICO_DIR=
